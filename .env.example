# ==============================================================================
# DependencyGuard AI - Environment Variables Configuration
# Copy this file to .env before starting the services
# ==============================================================================

# FalkorDB Graph Database Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=dependencyguard
FALKORDB_PASSWORD=

# Spring Boot Backend Server
PORT=8080
SERVER_PORT=8080

# AI Provider Configuration
# Options: 'deterministic' (recommended for zero-setup demo), 'gemini', or 'openai'
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

# Frontend Configuration
VITE_API_URL=http://localhost:8080
